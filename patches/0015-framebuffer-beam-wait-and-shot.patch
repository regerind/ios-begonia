@@ -279,6 +279,39 @@
  * to take between 5 and 40 ms; otherwise frames stay on their beat, as without it.
  */
 static TUNABLE(uint64_t, gLinePhysical, "fb_line", 0);
+/*
+ * begonia, boot-arg fb_beam_wait=MS: how long after the driver starts the scan is looked at (60000 as it was:
+ * a test session of a minute was over before the frames were written behind the scan).
+ */
+static TUNABLE(uint32_t, gBeamWait, "fb_beam_wait", 60000);
+/*
+ * begonia, boot-arg fb_shot=SECONDS: what is on the panel, into the log, SECONDS after boot and again 15 s later --
+ * for sessions nobody watches. Every eighth pixel of every eighth row, its brightness as one of 64 characters
+ * ("SHOTn ROW chars"; tools: the session notes say how it is made a picture again).
+ */
+static TUNABLE(uint32_t, gShot, "fb_shot", 0);
+
+static void
+panelShot(const uint8_t * base, uint32_t width, uint32_t height, uint32_t rowBytes, unsigned number)
+{
+	static const char marks[] = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz+/";
+	char line[260];
+
+	IOLog("SHOT%u begins: %u x %u, every 8th\n", number, width, height);
+	for (uint32_t y = 0; y < height; y += 8) {
+		unsigned n = 0;
+
+		for (uint32_t x = 0; x < width && n < sizeof(line) - 1; x += 8) {
+			uint32_t pixel = *(const volatile uint32_t *) (base + (size_t) y * rowBytes + (size_t) x * 4);
+			uint32_t grey = (((pixel >> 16) & 255) * 2 + ((pixel >> 8) & 255) * 5 + (pixel & 255)) >> 3;
+
+			line[n++] = marks[grey >> 2];
+		}
+		line[n] = 0;
+		IOLog("SHOT%u %03u %s\n", number, y / 8, line);
+	}
+	IOLog("SHOT%u ends\n", number);
+}
