@@ -263,6 +263,62 @@
 static TUNABLE(uint32_t, gBeam, "fb_beam", 1);
 extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
 static inline uint32_t refreshHz(void);
+/*
+ * begonia, boot-arg fb_shot=SECONDS: what is on the panel, into the log, SECONDS after boot and again every
+ * fb_shot_gap seconds (15), fb_shot_n times in all (2) -- for sessions nobody watches. Every fb_shot_step'th pixel
+ * (8) of every such row between fb_shot_top and fb_shot_bottom (percent of the height, 0 and 100), its brightness as
+ * one of 64 characters ("SHOTn ROW chars"; C:\begonia-private\sh\shot.py makes pictures of them again).
+ */
+static TUNABLE(uint32_t, gShot, "fb_shot", 0);
+static TUNABLE(uint32_t, gShotGap, "fb_shot_gap", 15);
+static TUNABLE(uint32_t, gShotCount, "fb_shot_n", 2);
+static TUNABLE(uint32_t, gShotStep, "fb_shot_step", 8);
+static TUNABLE(uint32_t, gShotTop, "fb_shot_top", 0);
+static TUNABLE(uint32_t, gShotBottom, "fb_shot_bottom", 100);
+static TUNABLE(uint32_t, gShotRgb, "fb_shot_rgb", 0);	/* 1: colour, twelve bits a pixel in two characters (SHOCn) */
+/* kern.hakios.fb_shot_now: set to 1 by a session's script (the notification com.hakios.shot): a shot at the next frame */
+static uint32_t gShotNow;
+SYSCTL_UINT(_kern_hakios, OID_AUTO, fb_shot_now, CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED, &gShotNow, 0, "a shot of the panel at the next frame");
+
+static void
+panelShot(const uint8_t * base, uint32_t width, uint32_t height, uint32_t rowBytes, unsigned number)
+{
+	static const char marks[] = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz+/";
+	static char line[1200];
+	uint32_t step = gShotStep >= 1 && gShotStep <= 64 ? gShotStep : 8;
+	uint32_t top = gShotTop < 100 ? height * gShotTop / 100 : 0;
+	uint32_t bottom = gShotBottom <= 100 && gShotBottom > gShotTop ? height * gShotBottom / 100 : height;
+
+	IOLog("SHOT%u begins: %u x %u, every %uth, rows %u to %u\n", number, width, height, step, top, bottom);
+	for (uint32_t y = top; y < bottom; y += step) {
+		unsigned n = 0;
+
+		for (uint32_t x = 0; x < width && n < sizeof(line) - 2; x += step) {
+			uint32_t pixel = *(const volatile uint32_t *) (base + (size_t) y * rowBytes + (size_t) x * 4);
+			uint32_t grey = (((pixel >> 16) & 255) * 2 + ((pixel >> 8) & 255) * 5 + (pixel & 255)) >> 3;
+
+			if (gShotRgb) {
+				line[n++] = marks[((pixel >> 18) & 0x3c) | ((pixel >> 14) & 3)];
+				line[n++] = marks[((pixel >> 8) & 0x30) | ((pixel >> 4) & 15)];
+			} else {
+				line[n++] = marks[grey >> 2];
+			}
+		}
+		line[n] = 0;
+		if (gShotRgb) {	/* (a line of the log keeps about 250 characters: the row in two halves) */
+			unsigned half = (n / 4) * 2;
+			char kept = line[half];
+
+			line[half] = 0;
+			IOLog("SHOC%u %03ua %s\n", number, (y - top) / step, line);
+			line[half] = kept;
+			IOLog("SHOC%u %03ub %s\n", number, (y - top) / step, line + half);
+		} else {
+			IOLog("SHOT%u %03u %s\n", number, (y - top) / step, line);
+		}
+	}
+	IOLog("SHOT%u ends\n", number);
+}
 
