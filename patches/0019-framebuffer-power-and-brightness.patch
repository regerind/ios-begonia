  * accelerator without the properties that name its Metal and OpenGL ES drivers is passed
  * over by both, which leaves CoreAnimation with its software renderer, as before.
  */
+/*
+ * begonia: what iOS sets on the framebuffer -- on an OLED iPhone the brightness goes there (DisplayBrightnessFactor,
+ * IOMFBBrightnessLevel, ...). Said (the first 80), so the backlight can be made to follow the right one.
+ */
+IOReturn
+IOMobileFramebuffer::setProperties(OSObject * properties)
+{
+	OSDictionary * dictionary = OSDynamicCast(OSDictionary, properties);
+	OSCollectionIterator * keys;
+	OSSymbol * key;
+	static unsigned said;
+
+	if (dictionary == NULL || (keys = OSCollectionIterator::withCollection(dictionary)) == NULL) {
+		return kIOReturnBadArgument;
+	}
+	while ((key = OSDynamicCast(OSSymbol, keys->getNextObject())) != NULL) {
+		OSObject * value = dictionary->getObject(key);
+		OSNumber * number = OSDynamicCast(OSNumber, value);
+		OSBoolean * truth = OSDynamicCast(OSBoolean, value);
+
+		if (said++ < 80) {
+			IOLog("MiniIOMobileFramebuffer: property %s set by pid %d: %s %llu\n", key->getCStringNoCopy(), proc_selfpid(),
+			    number ? "number" : truth ? "boolean" : OSDynamicCast(OSData, value) ? "data of length" : "other",
+			    number ? number->unsigned64BitValue() : truth ? truth->isTrue() :
+			    OSDynamicCast(OSData, value) ? ((OSData *) value)->getLength() : 0);
+		}
+	}
+	keys->release();
+	return kIOReturnSuccess;
+}
