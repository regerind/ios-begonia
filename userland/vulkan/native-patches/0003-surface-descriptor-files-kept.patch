+/* begonia (y308): CoreAnimation draws every frame into a new surface, so a descriptor was made and let go of for
+ * every frame: mkstemp, unlink, ftruncate to 12 MB, fstat, close -- ftruncate alone was the window server's most
+ * frequent running place (y307: 73 of 2462 samples). A file let go of is kept, up to 24 of them, and given again
+ * for the same size: its record is new (token, surface, no handle), only the file is an old one. */
+#define SURFACE_FD_SPARE 24
+static struct { int fd; uint64_t size; dev_t device; ino_t inode; } spare[SURFACE_FD_SPARE];
 
 int hakios_native_surface_fd_create(uint32_t surface,uint64_t size,uint64_t *token)
 {
