     *token=0;
+    pthread_mutex_lock(&surface_fd_lock);
+    for(unsigned k=0;k<SURFACE_FD_SPARE;k++)if(spare[k].size==size) {
+        int kept=spare[k].fd;dev_t device=spare[k].device;ino_t inode=spare[k].inode;
