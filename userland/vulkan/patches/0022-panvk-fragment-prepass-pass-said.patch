+/* begonia: two things the translated CoreAnimation fragment shaders do at every pixel that change no bit of the result.
+ *
+ * 1. Metal's `half` vectors come as 32-bit floats narrowed to halves in pairs, added or multiplied, widened one by one,
+ *    put in a vec4 and narrowed again: with the operations taken apart to scalars, NIR's own rules see the widening
+ *    of a half narrowed straight back (exact) and drop both.
+ * 2. A `half` read from a buffer is read as a word and decoded by hand to a 32-bit float (thirteen operations: the
+ *    exponent rebased, denormals by a multiplication, infinities, the sign), then narrowed to a half -- which is the
+ *    word's low 16 bits again. The narrowing takes the bits.
+ *
+ * Measured on the host (tests/bifrost_stats.c, Bifrost v7), instructions: the 3-tap blur 130 -> 88, the 7-tap 142 ->
+ * 86, the 14-tap 345 -> 162, a plain image layer 85 -> 63. The decoding's identity holds for every one of the 65536
+ * halves (NaN payloads aside), checked by computing it. PANVK_PREPASS turns it on. */
+static nir_alu_instr *
+begonia_alu(nir_def *def, nir_op op)
+{
+   if (nir_def_instr(def)->type != nir_instr_type_alu)
+      return NULL;
+   nir_alu_instr *alu = nir_instr_as_alu(nir_def_instr(def));
+   return alu->op == op && alu->def.num_components == 1 ? alu : NULL;
+}
+
+/* `alu` is `op(x, constant)` (either order where it commutes): x, and the constant in *k */
+static nir_def *
+begonia_with_const(nir_alu_instr *alu, bool commutes, uint64_t *k)
+{
+   if (!alu)
+      return NULL;
+   for (unsigned i = commutes ? 0 : 1; i < 2; i++) {
+      if (nir_src_is_const(alu->src[i].src) && alu->src[1 - i].swizzle[0] == 0 &&
+          alu->src[1 - i].src.ssa->num_components == 1) {
+         *k = nir_src_as_uint(alu->src[i].src);
+         return alu->src[1 - i].src.ssa;
+      }
+   }
+   return NULL;
+}
+
+/* the word whose low 16 bits `bits` decodes to a 32-bit float, or NULL */
+static nir_def *
+begonia_decoded_half(nir_def *bits)
+{
+   nir_alu_instr *join = begonia_alu(bits, nir_op_ior);
+   if (!join || bits->bit_size != 32)
+      return NULL;
+   for (unsigned side = 0; side < 2; side++) {
+      uint64_t k;
+      /* the sign: (x & 0x8000) << 16 */
+      nir_def *sign = begonia_with_const(begonia_alu(join->src[side].src.ssa, nir_op_ishl), false, &k);
+      if (!sign || k != 16 || join->src[side].swizzle[0] != 0)
+         continue;
+      nir_def *x = begonia_with_const(begonia_alu(sign, nir_op_iand), true, &k);
+      if (!x || k != 0x8000)
+         continue;
+      /* the rest: m < 0x400 ? u2f(m) * 2^-24 : (m << 13) + (m >= 0x7c00 ? 0x70000000 : 0x38000000), m = x & 0x7fff */
+      nir_alu_instr *pick = begonia_alu(join->src[1 - side].src.ssa, nir_op_bcsel);
+      if (!pick || join->src[1 - side].swizzle[0] != 0)
+         continue;
+      nir_def *m = begonia_with_const(begonia_alu(pick->src[0].src.ssa, nir_op_ult), false, &k);
+      if (!m || k != 0x400)
+         continue;
+      nir_def *mx = begonia_with_const(begonia_alu(m, nir_op_iand), true, &k);
+      if (mx != x || k != 0x7fff)
+         continue;
+      nir_alu_instr *small = begonia_alu(pick->src[1].src.ssa, nir_op_fmul);
+      nir_alu_instr *big = begonia_alu(pick->src[2].src.ssa, nir_op_iadd);
+      if (!small || !big)
+         continue;
+      bool small_ok = false;
+      for (unsigned i = 0; i < 2; i++) {
+         nir_alu_instr *as_float = begonia_alu(small->src[i].src.ssa, nir_op_u2f32);
+         if (as_float && as_float->src[0].src.ssa == m && nir_src_is_const(small->src[1 - i].src) &&
+             nir_src_as_float(small->src[1 - i].src) == 0x1p-24)
+            small_ok = true;
+      }
+      bool big_ok = false;
+      for (unsigned i = 0; i < 2; i++) {
+         nir_def *shifted = begonia_with_const(begonia_alu(big->src[i].src.ssa, nir_op_ishl), false, &k);
+         nir_alu_instr *bias = begonia_alu(big->src[1 - i].src.ssa, nir_op_bcsel);
+         if (shifted != m || k != 13 || !bias)
+            continue;
+         nir_def *top = begonia_with_const(begonia_alu(bias->src[0].src.ssa, nir_op_uge), false, &k);
+         if (top == m && k == 0x7c00 && nir_src_is_const(bias->src[1].src) && nir_src_is_const(bias->src[2].src) &&
+             nir_src_as_uint(bias->src[1].src) == 0x70000000 && nir_src_as_uint(bias->src[2].src) == 0x38000000)
+            big_ok = true;
+      }
+      if (small_ok && big_ok)
+         return x;
+   }
+   return NULL;
+}
+
+static bool
+begonia_half_bits_instr(nir_builder *b, nir_instr *instr, void *data)
+{
+   (void)data;
+   if (instr->type != nir_instr_type_alu)
+      return false;
+   nir_alu_instr *narrow = nir_instr_as_alu(instr);
+   if (narrow->op != nir_op_f2f16 && narrow->op != nir_op_f2f16_rtne)
+      return false;
+   if (narrow->def.num_components != 1 || narrow->src[0].src.ssa->num_components != 1)
+      return false;
+   nir_def *x = begonia_decoded_half(narrow->src[0].src.ssa);
+   if (!x)
+      return false;
+   b->cursor = nir_before_instr(instr);
+   nir_def_replace(&narrow->def, nir_u2u16(b, x));
+   return true;
+}
+
+static unsigned
+begonia_fragment_prepass(nir_shader *nir)
+{
+   bool halves = false;
+   if (nir->info.stage != MESA_SHADER_FRAGMENT)
+      return 0;
+   NIR_PASS(_, nir, nir_lower_alu_to_scalar, NULL, NULL);
+   NIR_PASS(_, nir, nir_lower_phis_to_scalar, NULL, NULL);
+   for (unsigned i = 0; i < 4; i++) {
+      NIR_PASS(_, nir, nir_opt_copy_prop);
+      NIR_PASS(_, nir, nir_opt_algebraic);
+      NIR_PASS(_, nir, nir_opt_constant_folding);
+      NIR_PASS(_, nir, nir_opt_cse);
+      NIR_PASS(_, nir, nir_opt_dce);
+   }
+   NIR_PASS(halves, nir, nir_shader_instructions_pass, begonia_half_bits_instr, nir_metadata_control_flow, NULL);
+   if (halves) {
+      NIR_PASS(_, nir, nir_opt_copy_prop);
+      NIR_PASS(_, nir, nir_opt_dce);
+      NIR_PASS(_, nir, nir_opt_cse);
+   }
+   return 1 + halves;
+}
