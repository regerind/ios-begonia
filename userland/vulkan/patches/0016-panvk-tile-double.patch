  */
+#include <stdlib.h>
+#include <string.h>
 #include "pan_fb.h"
 
 #include "pan_afbc.h"
@@ -60,6 +62,19 @@
     if (PAN_ARCH != 6 && fb->tile_size_px < 4 * 4)
        fb->tile_size_px *= 2;
 
+   /* begonia: PANVK_TILE_DOUBLE=1 -- a tile twice as large (the half of the tile buffer that pipelining
+    * keeps free is used too), as the check below allows: 2 colour targets give 16x16 tiles otherwise. */
+   {
+      static int doubled = -1;
+      if (doubled < 0) {
+         const char *e = getenv("PANVK_TILE_DOUBLE");
+         doubled = (e && e[0] == '1') || (getenv("PANVK_DEBUG") && strstr(getenv("PANVK_DEBUG"), "tile2"));
+      }
+      if (PAN_ARCH != 6 && doubled && fb->tile_size_px < pan_max_effective_tile_size(PAN_ARCH) &&
+          ALIGN_POT(rt_B_per_px * fb->tile_size_px * 2, 1024) <= fb->tile_rt_budget_B * 2)
+         fb->tile_size_px *= 2;
+   }
+
    /* Clamp tile size to hardware limits */
    fb->tile_size_px =
       MIN2(fb->tile_size_px, pan_max_effective_tile_size(PAN_ARCH));
