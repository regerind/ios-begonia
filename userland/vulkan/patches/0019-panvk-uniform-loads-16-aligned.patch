+#define NL "\n"
+/* begonia: a fragment shader that took its buffer offsets for multiples of 16 (panvk_vX_shader.c): one that is not is said */
+static void
+begonia_check_ubo_bases(struct panvk_cmd_buffer *cmdbuf)
+{
+   const struct panvk_shader *fs_shader = get_fs(cmdbuf);
+   const struct panvk_shader_variant *fs = fs_shader ? panvk_shader_only_variant(fs_shader) : NULL;
+   uint64_t words = fs ? fs->begonia_ubo_base_words : 0;
+   static unsigned draws, wrong;
+   if (!words)
+      return;
+   draws++;
+   while (words) {
+      const unsigned w = ffsll(words) - 1;
+      const uint32_t v = ((const uint32_t *)cmdbuf->state.push_constants.data)[w];
+      words &= words - 1;
+      if ((v & 15) && wrong++ < 16)
+         fprintf(stderr, "panvk: begonia: buffer offset word %u is %u, not a multiple of 16 (draw %u)" NL, w, v, draws);
+   }
+   if ((draws & 16383) == 1 && getenv("PANVK_UBO_ALIGN16_STATS"))
+      fprintf(stderr, "panvk: begonia: %u draws with 16-aligned uniform loads, %u offsets were not" NL, draws, wrong);
+}
