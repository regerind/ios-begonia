+/*
+ * begonia: a host image copy (VK_EXT_host_image_copy), said on the console the first times: the Metal runtime makes
+ * a texture's first contents with one, and on the phone the processor's write into the tiled image faulted outside
+ * the mapping (Freeform, y29: pan_store_tiled_image from panvk_CopyMemoryToImage). What was mapped, how big, and
+ * where the copy goes.
+ */
+static void
+begonia_host_copy_say(const char *format, ...)
+{
+   static int fd = -2;
+   static unsigned said;
+   char line[512];
+   va_list ap;
+   int n;
+
+   if (said >= 24)
+      return;
+   if (fd == -2)
+      fd = open("/dev/console", O_WRONLY | O_NOCTTY);
+   if (fd < 0)
+      return;
+   said++;
+   va_start(ap, format);
+   n = vsnprintf(line, sizeof(line), format, ap);
+   va_end(ap);
+   if (n > (int)sizeof(line) - 1)
+      n = sizeof(line) - 1;
+   if (n > 0)
+      (void)write(fd, line, n);
+}
+
