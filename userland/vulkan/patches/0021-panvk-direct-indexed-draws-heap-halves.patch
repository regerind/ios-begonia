+   /* begonia: PANVK_HALVES: consecutive batches begin their polygon lists in the tiler heap's two halves in turn (every
+    * batch began at the heap's start, so a batch's tiler could not run while the batch before it was still drawn from
+    * its lists). The kernel's service reads the heap's base of a pixel job and of the chain behind it and runs them at
+    * once where they differ. Done once a batch: its template still has the whole heap. */
+   {
+      static int halves = -1;
+      static uint32_t batches;
+      struct panvk_device *dev = to_panvk_device(cmdbuf->vk.base.device);
+      const uint64_t whole = pan_kmod_bo_size(dev->tiler_heap->bo);
+      if (halves < 0)
+         halves = getenv("PANVK_HALVES") != NULL;
+      pan_unpack(&batch->tiler.heap_templ, TILER_HEAP, heap);
+      if (halves && batch->tiler.heap_desc.cpu && heap.size == whole) {
+         const uint64_t half = whole / 2;
+         const uint64_t at = dev->tiler_heap->addr.dev + (p_atomic_inc_return(&batches) & 1) * half;
+         pan_pack(&batch->tiler.heap_templ, TILER_HEAP, cfg) {
+            cfg.size = half;
+            cfg.base = at;
+            cfg.bottom = at;
+            cfg.top = at + half;
+         }
+         memcpy(batch->tiler.heap_desc.cpu, &batch->tiler.heap_templ, sizeof(batch->tiler.heap_templ));
+      }
+   }
+
    draw->tiler_ctx = &batch->tiler.ctx;
    return VK_SUCCESS;
 }
