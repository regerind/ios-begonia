+      static uint32_t batches;
+      struct panvk_device *dev = to_panvk_device(cmdbuf->vk.base.device);
+      const uint64_t whole = pan_kmod_bo_size(dev->tiler_heap->bo);
+      if (halves < 0)
+         halves = getenv("PANVK_HALVES") != NULL;
+      pan_unpack(&batch->tiler.heap_templ, TILER_HEAP, heap);
+      if (halves && batch->tiler.heap_desc.cpu && heap.size == whole) {
+         const uint64_t half = whole / 2;
