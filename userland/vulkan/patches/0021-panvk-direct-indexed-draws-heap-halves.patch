+   /* begonia: with the lowest and highest index known (found above on the CPU) nothing of the draw is left for the GPU
+    * to work out: drawn directly, as a draw without indices is, with the vertex job over the indices' range and the
+    * tiler reading the indices. No helper job (a compute job a draw), and no varyings in the device's one buffer for
+    * indirect draws. */
+   /* begonia: Metal restarts a strip at the all-ones index always. y294's counters: the vertex shader ran 250 million
+    * times in 5 s for 36000 triangles -- about 65536 vertices a draw: draws of strips came here with the restart off
+    * and their all-ones indices counted as the highest index (and drawn as a vertex). For a strip without the restart
+    * the indices are looked at again: with an all-ones index among them the draw restarts there, and the range is the
+    * other indices'. Counted and said every 4096 draws. */
+   {
+      const VkPrimitiveTopology topo = cmdbuf->vk.dynamic_graphics_state.ia.primitive_topology;
+      const bool strip = topo == VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP || topo == VK_PRIMITIVE_TOPOLOGY_LINE_STRIP;
+      const struct panvk_buffer *ib = cmdbuf->state.gfx.ib.buf;
+      const uint32_t isz = cmdbuf->state.gfx.ib.index_size;
+      static uint32_t n_draws, n_strip, n_valid, n_ones, n_made, n_restart;
+      static uint64_t range_before, range_after;
+      uint32_t mn = UINT32_MAX, mx = 0;
+      bool ones = false, any = false;
+
+      if (draw.cpu_minmax.valid && !draw.info.index.restart_enable && ib && ib->bound_mem &&
+          ib->bound_mem->addr.host) {
+         const uint8_t *bytes = (const uint8_t *)ib->bound_mem->addr.host + ib->bound_offset +
+                                cmdbuf->state.gfx.ib.buf_offset + (uint64_t)firstIndex * isz;
+         const uint32_t all = isz == 4 ? UINT32_MAX : isz == 2 ? UINT16_MAX : UINT8_MAX;
+         for (uint32_t i = 0; i < indexCount; i++) {
+            uint32_t v = isz == 4 ? ((const uint32_t *)bytes)[i]
+                                  : isz == 2 ? ((const uint16_t *)bytes)[i] : bytes[i];
+            if (v == all) {
+               ones = true;
+               continue;
+            }
+            if (v < mn) mn = v;
+            if (v > mx) mx = v;
+            any = true;
+         }
+      }
+      n_draws++;
+      n_strip += strip;
+      n_valid += draw.cpu_minmax.valid;
+      n_ones += ones;
+      n_restart += draw.info.index.restart_enable;
+      if (draw.cpu_minmax.valid)
+         range_before += draw.cpu_minmax.max - draw.cpu_minmax.min + 1;
+      if (ones && strip && any && begonia_strip_restart()) {
+         draw.info.index.restart_enable = true;
+         draw.cpu_minmax.min = mn;
+         draw.cpu_minmax.max = mx;
+         n_made++;
+      }
+      if (draw.cpu_minmax.valid)
+         range_after += draw.cpu_minmax.max - draw.cpu_minmax.min + 1;
+      if ((n_draws & 4095) == 0) {
+         fprintf(stderr, "panvk: begonia: indexed draws %u: strips %u, range known %u, restart on %u, an all-ones index "
+                         "without restart %u (made restarts %u); vertices in all before %llu after %llu; now topology %u "
+                         "index size %u count %u\n",
+                 n_draws, n_strip, n_valid, n_restart, n_ones, n_made, (unsigned long long)range_before,
+                 (unsigned long long)range_after, (unsigned)topo, isz, indexCount);
+      }
+   }
+
+   if (draw.cpu_minmax.valid && begonia_direct_indexed()) {
+      const uint32_t range = draw.cpu_minmax.max - draw.cpu_minmax.min + 1;
+      struct panvk_draw_data direct = {
+         .info = {
+            .index = panvk_draw_info_index(cmdbuf, firstIndex),
+            .vertex.base = vertexOffset,
+            .vertex.raw_offset = (int32_t)draw.cpu_minmax.min + vertexOffset,
+            .vertex.count = indexCount,
+            .instance.base = firstInstance,
+            .instance.count = instanceCount,
+            .indirect.stride = BEGONIA_DIRECT_INDEXED,
+            .prim = panvk_get_client_prim(cmdbuf),
+         },
+         .vertex_range = range,
+         .padded_vertex_count = padded_vertex_count(cmdbuf, range, instanceCount),
+      };
+
+      direct.info.index.restart_enable = draw.info.index.restart_enable;
+
+      panvk_cmd_draw(cmdbuf, &direct);
+      return;
+   }
+
    panvk_cmd_draw_indirect(cmdbuf, &draw);
 }
 
