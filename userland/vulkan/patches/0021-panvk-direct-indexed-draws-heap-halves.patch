+/* begonia: marks a draw data's indexed draw as direct (in info.indirect.stride, which a direct draw does not use) */
+#define BEGONIA_DIRECT_INDEXED 0xd12ec7ed
+
+/* begonia: PANVK_DIRECT: indexed draws directly; PANVK_DIRECT_SLICES: not in every fourth 5-second slice of the time
+ * since boot (a measurement: the slice's number modulo 4 is 0). */
+static bool
+begonia_direct_indexed(void)
+{
+   static int mode = -1;
+   if (mode < 0)
+      mode = getenv("PANVK_DIRECT_SLICES") ? 2 : getenv("PANVK_DIRECT") ? 1 : 0;
+   if (mode == 2) {
+      struct timespec ts;
+#ifdef __APPLE__
+      clock_gettime(CLOCK_UPTIME_RAW, &ts);
+#else
+      clock_gettime(CLOCK_MONOTONIC, &ts);
+#endif
+      return ((ts.tv_sec / 5) & 3) != 0;
+   }
+   return mode == 1;
+}
+
+/* begonia: PANVK_RESTART: a strip's all-ones index is a restart (see CmdDrawIndexed); PANVK_RESTART_SLICES: in the
+ * 5-second slices of the time since boot whose number modulo 4 is 2 or 3 (a measurement). */
+static bool
+begonia_strip_restart(void)
+{
+   static int mode = -1;
+   if (mode < 0)
+      mode = getenv("PANVK_RESTART_SLICES") ? 2 : getenv("PANVK_RESTART") ? 1 : 0;
+   if (mode == 2) {
+      struct timespec ts;
+#ifdef __APPLE__
+      clock_gettime(CLOCK_UPTIME_RAW, &ts);
+#else
+      clock_gettime(CLOCK_MONOTONIC, &ts);
+#endif
+      return ((ts.tv_sec / 5) & 3) >= 2;
+   }
+   return mode == 1;
+}
+
 static bool
 is_indirect_draw(const struct panvk_draw_data *draw)
 {
+   /* begonia: an indexed draw whose lowest and highest index are known here is drawn directly (CmdDrawIndexed) */
+   if (draw->info.indirect.stride == BEGONIA_DIRECT_INDEXED)
+      return false;
+
    return draw->info.indirect.buffer_dev_addr != 0 ||
           draw->info.index.index_size != 0;
 }
