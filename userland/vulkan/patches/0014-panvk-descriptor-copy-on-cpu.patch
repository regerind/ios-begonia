+                              &copy_info,
+                              panvk_priv_mem_host_addr(desc_info->others.map),
+                              copy_info.desc_copy.limits[PANVK_BIFROST_DESC_TABLE_COUNT - 1],
+                              attrib_buf_idx_offset))
