+/* begonia: what closes batches, counted (the window server on Metal, y205: ~40 fragment jobs
+ * a frame for 7 render passes). In backboardd a line on the console every 512 batches that
+ * held jobs: batches, those with a framebuffer (a fragment job each), barriers that closed a
+ * batch holding draws, BeginRendering calls that were not resuming, EndCommandBuffer calls.
+ * Counters only. */
+#include <fcntl.h>
+#include <stdlib.h>
+#include <unistd.h>
+uint32_t panvk_per_arch(begonia_stats)[8];
+
+static void
+begonia_note_batch(const struct panvk_batch *batch)
+{
+   uint32_t *s = panvk_per_arch(begonia_stats);
+   static int fd = -2;
+
+   if (!batch->fb.desc.gpu && !batch->vtc_jc.first_job)
+      return;
+   if (batch->fb.desc.gpu)
+      p_atomic_inc(&s[1]);
+   if ((p_atomic_inc_return(&s[0]) & 511) != 0)
+      return;
+   if (fd == -2)
+      fd = strcmp(getprogname(), "backboardd") == 0 ? open("/dev/console", O_WRONLY | O_NOCTTY) : -1;
+   if (fd >= 0) {
+      char line[240];
+      int n = snprintf(line, sizeof(line),
+                       "panvk: batches %u, with a framebuffer %u; barriers closing a batch with draws %u, "
+                       "without %u; BeginRendering %u, resuming %u; EndCommandBuffer %u\n",
+                       s[0], s[1], s[2], s[3], s[4], s[5], s[6]);
+      if (n > 0)
+         (void)!write(fd, line, n);
+   }
+}
+
