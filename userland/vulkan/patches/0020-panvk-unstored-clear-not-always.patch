+/* begonia: a colour attachment that is cleared but not stored (CoreAnimation hangs a second, memoryless one on every
+ * pass and no pipeline writes it) asked for its clear on every tile ("always"), and with that the pass's whole frame
+ * shader ran on every tile: the first attachment's load -- a read of the whole 1080x2340 surface -- even where no
+ * triangle falls. Nobody reads what is not stored, so such an attachment no longer asks; the load then runs on the
+ * tiles the pass draws in (INTERSECT), the others are neither read nor written.
+ * PANVK_INTERSECT: on. PANVK_INTERSECT_SLICES: on in the odd 5-second slices of the time since boot (a measurement). */
+static bool
+begonia_clear_always(const VkRenderingAttachmentInfo *att)
+{
+   static int mode = -1;
+   if (mode < 0)
+      mode = getenv("PANVK_INTERSECT_SLICES") ? 2 : getenv("PANVK_INTERSECT") ? 1 : 0;
+   if (mode == 2) {
+      struct timespec ts;
+#ifdef __APPLE__
+      clock_gettime(CLOCK_UPTIME_RAW, &ts);
+#else
+      clock_gettime(CLOCK_MONOTONIC, &ts);
+#endif
+      if (!((ts.tv_sec / 5) & 1))
+         return true;
+   } else if (!mode) {
+      return true;
+   }
+   return att->storeOp == VK_ATTACHMENT_STORE_OP_STORE;
+}
