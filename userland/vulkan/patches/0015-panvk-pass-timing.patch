+#include <time.h>
+#include <unistd.h>
+#include "util/format/u_format.h"
+
+/* begonia: PANVK_DEBUG=passtime -- each batch is waited for twice (its vertex/tiler jobs, then its
+ * fragment job) and, when it took 3 ms or more, one line goes to the console (backboardd only):
+ * vertex ms, fragment ms, render area, colour formats, load (L image, C clear, N none) and store
+ * (1/0) of colour 0 and 1, jobs in the batch. The batches run one after the other then: the
+ * times are the GPU's own, the frame rate is not. */
+static bool
+begonia_passtime(void)
+{
+   static int on = -1;
+   if (on < 0) {
+      const char *e = getenv("PANVK_DEBUG");
+      on = e && strstr(e, "passtime") != NULL;
+   }
+   return on;
+}
+
+static uint64_t
+begonia_now_us(void)
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return (uint64_t)ts.tv_sec * 1000000ull + ts.tv_nsec / 1000;
+}
+
+static void
+begonia_say_pass(const struct panvk_batch *b, uint64_t v_us, uint64_t f_us)
+{
+   static int fd = -2;
+   if (v_us + f_us < 3000)
+      return;
+   if (fd == -2)
+      fd = strcmp(getprogname(), "backboardd") == 0 ? open("/dev/console", O_WRONLY | O_NOCTTY) : -1;
+   if (fd < 0)
+      return;
+   char line[120];
+   int n = snprintf(line, sizeof(line), "pt v%.1f f%.1f %ux%u r%u %.9s/%.9s L%c%c S%c%c j%u t%u s%u\n",
+                    v_us / 1000.0, f_us / 1000.0, b->begonia.w, b->begonia.h, b->begonia.rt_count,
+                    util_format_short_name(b->begonia.fmt[0]), util_format_short_name(b->begonia.fmt[1]),
+                    b->begonia.load[0], b->begonia.load[1], b->begonia.store[0], b->begonia.store[1],
+                    b->begonia.jobs, b->begonia.tile, b->begonia.samples);
+   if (n > 0)
+      (void)!write(fd, line, n);
+}
+
