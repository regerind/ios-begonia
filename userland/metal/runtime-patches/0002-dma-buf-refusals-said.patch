+/// begonia: why the dma-buf route refused a no-copy buffer or a texture's image, on the console (the
+/// first 16): the refusal itself is `Unsupported(HostMemory)` whatever the step, and the caller then
+/// takes a buffer that copies the bytes, without a word.
+pub(super) fn begonia_say(what: &str) {
+    use std::io::Write;
+    static SAID: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+    if SAID.fetch_add(1, std::sync::atomic::Ordering::Relaxed) < 16 {
+        if let Ok(mut console) = std::fs::OpenOptions::new().write(true).open("/dev/console") {
+            let _ = writeln!(console, "m2v: dma-buf route: {what}");
+        }
+    }
+}
