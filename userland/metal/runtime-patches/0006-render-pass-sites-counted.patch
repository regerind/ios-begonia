 pub use work_counts::WorkCounts;
 pub use wrapped_buffer::{VkBufferMemory, WrappedBufferProblem};
 pub use ycbcr::{IoSurfaceYCbCr, SurfaceYCbCrMatrix};
+
+/// begonia: how often each place that begins a Vulkan render pass ran (printed with the encoder line, `render.rs`).
+pub(crate) static BEGONIA_SITES: [std::sync::atomic::AtomicU64; 16] =
+    [const { std::sync::atomic::AtomicU64::new(0) }; 16];
+
+pub(crate) fn begonia_site(which: usize) {
+    BEGONIA_SITES[which].fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+}
