+/// begonia: every 256th byte's word of `len` bytes at `bytes` from byte `64 * phase` on, hashed;
+/// never 0. (y297: every 64th byte's word of a surface took 520 us a look, three looks a frame; a
+/// look now reads a quarter, and four looks in a row read what one read.)
+///
+/// # Safety
+///
+/// `len` bytes at `bytes` are readable.
+unsafe fn begonia_sparse_hash(bytes: *const u8, len: usize, phase: usize) -> u64 {
+    let mut hash: u64 = 0xcbf2_9ce4_8422_2325;
+    let mut at = 64 * (phase & 3);
+    while at + 8 <= len {
+        // SAFETY: the caller's contract; the word lies within `len`.
+        let word = unsafe { std::ptr::read_unaligned(bytes.add(at).cast::<u64>()) };
+        hash = (hash ^ word).wrapping_mul(0x0000_0100_0000_01b3).rotate_left(23);
+        at += 256;
+    }
+    hash | 1
+}
