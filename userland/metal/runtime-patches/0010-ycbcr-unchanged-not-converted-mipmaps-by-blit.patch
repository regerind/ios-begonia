+/// begonia: a switch read once from the environment: `name` set: on; `name` with `_S` after it set: on
+/// in the 5-second slices of the time since boot whose number modulo 4 has `bit` (a measurement
+/// on the device: the kernel's statistics follow the same slices).
+pub(crate) fn begonia_switch(cell: &std::sync::OnceLock<u8>, name: &str, bit: u64) -> bool {
+    let mode = *cell.get_or_init(|| {
+        if std::env::var(format!("{name}_S")).is_ok() {
+            2
+        } else if std::env::var(name).is_ok() {
+            1
+        } else {
+            0
+        }
+    });
+    if mode != 2 {
+        return mode == 1;
+    }
+    let mut ts = libc::timespec {
+        tv_sec: 0,
+        tv_nsec: 0,
+    };
+    #[cfg(target_vendor = "apple")]
+    let clock = libc::CLOCK_UPTIME_RAW;
+    #[cfg(not(target_vendor = "apple"))]
+    let clock = libc::CLOCK_MONOTONIC;
+    // SAFETY: `ts` is a timespec of this frame's.
+    unsafe {
+        libc::clock_gettime(clock, &mut ts);
+    }
+    ((ts.tv_sec as u64 / 5) & 3) & bit != 0
+}
