+/// # Safety
+///
+/// `len` bytes at `bytes` are readable.
+unsafe fn begonia_sparse_hash(bytes: *const u8, len: usize) -> u64 {
+    let mut hash: u64 = 0xcbf2_9ce4_8422_2325;
+    let mut at = 0usize;
+    while at + 8 <= len {
+        // SAFETY: the caller's contract; the word lies within `len`.
+        let word = unsafe { std::ptr::read_unaligned(bytes.add(at).cast::<u64>()) };
+        hash = (hash ^ word).wrapping_mul(0x0000_0100_0000_01b3).rotate_left(23);
+        at += 64;
+    }
+    hash | 1
+}
