+/*
+ * begonia (y135): a texture about to be rendered into while batches that are not sent yet read it gets new memory
+ * instead of those batches being sent first (pan_job.c, PAN_RENAME=1). CoreAnimation renders every backdrop's blur
+ * in the same few scratch textures; the display's picture reads the last blur and then the next blur writes the
+ * texture again, and the picture's batch was sent and later loaded again in full -- ~6.6 times a frame with YouTube
+ * (y134). The readers keep the old memory (their batches hold it); the new memory's content is undefined but for AFBC's
+ * headers, as when a texture is made: right where the writer clears what it uses first, as CoreAnimation does.
+ */
+int
+panfrost_resource_rename_bo(struct panfrost_context *ctx, struct panfrost_resource *rsrc)
+{
+   struct panfrost_device *dev = pan_device(ctx->base.screen);
+   struct panfrost_bo *bo = rsrc->bo;
+   struct panfrost_bo *newbo;
+
+   if (!bo || (bo->flags & PAN_BO_SHARED))
+      return -1;
+   newbo = panfrost_bo_create(dev, panfrost_bo_size(bo), bo->flags, bo->label);
+   if (!newbo)
+      return -1;
+   panfrost_bo_unreference(rsrc->bo);
+   rsrc->bo = newbo;
+   rsrc->image.data.base = newbo->ptr.gpu;
+   if (drm_is_afbc(rsrc->image.layout.modifier) && panfrost_resource_init_afbc_headers(rsrc))
+      return -1;
+   panfrost_dirty_state_all(ctx);
+   return 0;
+}
