+/*
+ * begonia (x39): which job last named each buffer made here (DRM_PANFROST_CREATE_BO), and a job known
+ * to be done. The jobs end in the order they were given, so a buffer whose last job is not after that
+ * one is idle, and panfrost's look at it (WAIT_BO, 48 a frame from its buffer cache: x37, 6.9% of the
+ * drawing thread in them) need not go to the kernel. Buffers that are IOSurfaces are always asked
+ * about there: the kernel's answer also brings what the GPU wrote into the processor's view.
+ */
+#define BUFFERS_KNOWN 8192
+static uint64_t buffer_job[BUFFERS_KNOWN];      /* the last job that named it; 0: none yet */
+static uint8_t buffer_own[BUFFERS_KNOWN];       /* made here, not closed */
+static uint64_t job_done;                       /* a job known done, and so every one before it */
+static unsigned looks_here, looks_asked;
+
+static void
+job_is_done(uint64_t seq)
+{
+	uint64_t known = __atomic_load_n(&job_done, __ATOMIC_RELAXED);
+
+	while (seq > known && !__atomic_compare_exchange_n(&job_done, &known, seq, true, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {
+	}
+}
+
+static void
+buffer_made(uint32_t handle)
+{
+	if (handle < BUFFERS_KNOWN) {
+		__atomic_store_n(&buffer_job[handle], 0, __ATOMIC_RELAXED);
+		__atomic_store_n(&buffer_own[handle], 1, __ATOMIC_RELAXED);
+	}
+}
+
+static void
+buffer_forget(uint32_t handle)
+{
+	if (handle < BUFFERS_KNOWN) {
+		__atomic_store_n(&buffer_own[handle], 0, __ATOMIC_RELAXED);
+		__atomic_store_n(&buffer_job[handle], 0, __ATOMIC_RELAXED);
+	}
+}
