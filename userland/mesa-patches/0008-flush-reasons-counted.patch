 static void panfrost_batch_submit(struct panfrost_context *ctx,
                                   struct panfrost_batch *batch);
 
+
+/*
+ * begonia (y134): why batches are submitted, counted (whatever PAN_MESA_DEBUG says): with YouTube the display's
+ * picture was split into ~12 batches a frame, each a full-screen fragment job, and reading the backdrops from the frame
+ * before (the bridge's glbackdrop=1) did not change that. osmesa_flush_reasons() says the counts and starts again.
+ */
+#define PAN_FLUSH_REASONS 24
+static struct { const char *why; unsigned count; } pan_flush_reasons[PAN_FLUSH_REASONS];
+
+static void
+pan_count_flush(const char *why)
+{
+   if (!why)
+      why = "(none)";
+   for (unsigned i = 0; i < PAN_FLUSH_REASONS; i++) {
+      if (pan_flush_reasons[i].why == why || !pan_flush_reasons[i].why) {
+         pan_flush_reasons[i].why = why;
+         pan_flush_reasons[i].count++;
+         return;
+      }
+   }
+}
+
+__attribute__((visibility("default"))) int osmesa_flush_reasons(char *out, unsigned size);
+__attribute__((visibility("default"))) int
+osmesa_flush_reasons(char *out, unsigned size)
+{
+   int o = 0;
+   for (unsigned i = 0; i < PAN_FLUSH_REASONS && pan_flush_reasons[i].why; i++) {
+      if (o < (int)size - 1)
+         o += snprintf(out + o, size - o, " %s: %u;", pan_flush_reasons[i].why, pan_flush_reasons[i].count);
+      pan_flush_reasons[i].count = 0;
+   }
+   return o;
+}
+
