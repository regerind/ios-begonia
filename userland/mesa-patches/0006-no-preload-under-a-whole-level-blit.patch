--- a/src/gallium/drivers/panfrost/pan_blit.c
+++ b/src/gallium/drivers/panfrost/pan_blit.c
@@ -113,5 +113,29 @@
    enum pipe_format dst_view_format = util_format_linear(info->dst.format);
    pan_legalize_format(ctx, dst, dst_view_format, true, false);
 
+   /* begonia: a blit that writes every pixel of a level needs nothing of what
+    * was there. The level is taken as not written yet, so that the batch the
+    * blit goes into does not begin by reading it all back (the preload of
+    * panfrost_batch_to_fb_info(); the batch marks it written again when it is
+    * submitted). The window server's bridge copies every frame into its
+    * IOSurface this way, and an imported surface always counts as written:
+    * the GPU read 10 MB of the old frame to draw the new one over all of it.
+    */
+   if (!info->scissor_enable && !info->window_rectangle_include &&
+       !info->alpha_blend && !info->render_condition_enable &&
+       (info->mask & PIPE_MASK_RGBA) == PIPE_MASK_RGBA &&
+       info->dst.resource->target == PIPE_TEXTURE_2D &&
+       info->dst.resource->nr_samples <= 1 && info->dst.box.depth == 1) {
+      int x0 = MIN2(info->dst.box.x, info->dst.box.x + info->dst.box.width);
+      int x1 = MAX2(info->dst.box.x, info->dst.box.x + info->dst.box.width);
+      int y0 = MIN2(info->dst.box.y, info->dst.box.y + info->dst.box.height);
+      int y1 = MAX2(info->dst.box.y, info->dst.box.y + info->dst.box.height);
+
+      if (x0 <= 0 && y0 <= 0 &&
+          x1 >= (int)u_minify(info->dst.resource->width0, info->dst.level) &&
+          y1 >= (int)u_minify(info->dst.resource->height0, info->dst.level))
+         BITSET_CLEAR(dst->valid.data, info->dst.level);
+   }
+
    panfrost_blit_no_afbc_legalization(pipe, info);
 }
