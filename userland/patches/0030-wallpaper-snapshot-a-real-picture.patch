--- a/userland/src/inject_sb.c
+++ b/userland/src/inject_sb.c
@@ -2327,6 +2327,216 @@
 	say("hakios: open: %s: %d\n", identifier, ((BOOL (*)(id, SEL, id, BOOL))objc_msgSend)(application, launch, name, 0));
 }
 
+/*
+ * begonia: the purple behind one-handed mode (and wherever else a frosted material takes its bottom layer from the
+ * wallpaper's snapshot). PaperBoardUI's snapshot sources hand out the picture PosterBoard left in
+ * .../RuntimeSnapshot-home.atx, and on this phone that picture is magenta from corner to corner (y5: 255,0,255 in every
+ * part looked at): whatever renders the poster for the snapshot has nothing to render it with here. So the sources
+ * answer with a picture of the wallpaper as it really is on the panel -- taken once, with the icons and the status bar
+ * out of the way for under half a second, kept in /var/mobile/Library (wallpaper_keep()) and taken again only when the
+ * snapshot's name changes, which it does when another wallpaper is chosen. The wallpaper itself is not touched: it
+ * stays the live poster. Boot-arg wallpaper_snapshot=0: the sources answer as Darwin has them.
+ */
+#define SNAPSHOT_NAME_KEPT "/var/mobile/Library/hakios-wallpaper.name"
+static id snapshot_picture;             /* ours, kept for good; NULL: none yet */
+static char snapshot_name_kept[1024];   /* the name of the snapshot our picture was taken for */
+static char snapshot_name_now[1024];    /* the name the sources have now */
+static bool snapshot_pass_running;
+static unsigned snapshot_answers, snapshot_passes;
+static id (*original_baked_snapshot)(id self, SEL selector);
+static id (*original_url_snapshot)(id self, SEL selector);
+
+static void snapshot_pass(unsigned attempt);
+
+static void
+snapshot_wanted(id source)
+{
+	const char *name;
+
+	if (source == NULL || !class_respondsToSelector(object_getClass(source), sel_registerName("cacheIdentifier"))) {
+		return;
+	}
+	name = text_of(SEND(id, source, "cacheIdentifier"));
+	if (strstr(name, "-home") == NULL || strcmp(name, snapshot_name_now) == 0) {
+		return;
+	}
+	snprintf(snapshot_name_now, sizeof(snapshot_name_now), "%s", name);
+	if (strcmp(snapshot_name_now, snapshot_name_kept) != 0 && !snapshot_pass_running) {
+		say("hakios: snapshot: the wallpaper's snapshot is now %.300s: a picture of it is to be taken\n", snapshot_name_now);
+		snapshot_pass_running = true;
+		dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 3 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+			snapshot_pass(0);
+		});
+	}
+}
+
+static id
+snapshot_answer(id self, SEL selector, id (*original)(id, SEL))
+{
+	snapshot_wanted(self);
+	if (snapshot_picture != NULL) {
+		if (snapshot_answers++ < 4 || snapshot_answers % 200 == 0) {
+			say("hakios: snapshot: %s answers with the picture of the wallpaper (%u times so far)\n", object_getClassName(self),
+			    snapshot_answers);
+		}
+		return snapshot_picture;
+	}
+	return original(self, selector);
+}
+
+static id
+baked_snapshot(id self, SEL selector)
+{
+	return snapshot_answer(self, selector, original_baked_snapshot);
+}
+
+static id
+url_snapshot(id self, SEL selector)
+{
+	return snapshot_answer(self, selector, original_url_snapshot);
+}
+
+/* The picture taken: the home screen showing, its icons and the status bar hidden for as long as a few frames take. */
+static void
+snapshot_pass(unsigned attempt)
+{
+	id app = SEND(id, objc_getClass("UIApplication"), "sharedApplication");
+	Class window = objc_getClass("UIWindow");
+	SEL all = sel_registerName("allWindowsIncludingInternalWindows:onlyVisibleWindows:");
+	id windows = window && class_getClassMethod(window, all) ? ((id (*)(Class, SEL, BOOL, BOOL))objc_msgSend)(window, all, 1, 1) :
+	    app ? SEND(id, app, "windows") : NULL;
+	long count = windows ? SEND(long, windows, "count") : 0;
+	CFMutableArrayRef hidden;
+
+	if (!wallpaper_home_showing() || count == 0) {
+		if (attempt < 1200) {
+			dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 3 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+				snapshot_pass(attempt + 1);
+			});
+		} else {
+			snapshot_pass_running = false;
+		}
+		return;
+	}
+	hidden = CFArrayCreateMutable(NULL, 0, &kCFTypeArrayCallBacks);
+	for (long i = 0; i < count; i++) {
+		id other = SEND1(id, windows, "objectAtIndex:", long, i);
+		const char *name = object_getClassName(other);
+
+		if ((strcmp(name, "SBHomeScreenWindow") == 0 || strcmp(name, "UIStatusBarWindow") == 0) && !SEND(BOOL, other, "isHidden")) {
+			SEND1(void, other, "setHidden:", BOOL, YES);
+			CFArrayAppendValue(hidden, other);
+		}
+	}
+	snapshot_passes++;
+	dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 450 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+		id image = wallpaper_picture(1.0);
+
+		for (CFIndex i = 0; i < CFArrayGetCount(hidden); i++) {
+			SEND1(void, (id)CFArrayGetValueAtIndex(hidden, i), "setHidden:", BOOL, NO);
+		}
+		CFRelease(hidden);
+		if (image != NULL) {
+			int fd = open(SNAPSHOT_NAME_KEPT, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+
+			if (snapshot_picture != NULL) {
+				CFRelease((CFTypeRef)snapshot_picture);
+			}
+			snapshot_picture = (id)CFRetain((CFTypeRef)image);
+			snprintf(snapshot_name_kept, sizeof(snapshot_name_kept), "%s", snapshot_name_now);
+			if (fd >= 0) {
+				write(fd, snapshot_name_kept, strlen(snapshot_name_kept));
+				close(fd);
+			}
+			snapshot_pass_running = false;
+			say("hakios: snapshot: a picture of the wallpaper taken (pass %u) and kept for %.200s\n", snapshot_passes,
+			    snapshot_name_kept);
+		} else if (attempt < 1200) {
+			dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 5 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+				snapshot_pass(attempt + 1);
+			});
+		} else {
+			snapshot_pass_running = false;
+		}
+	});
+}
+
+/* The sources the wallpaper's own views have, asked before anything needs their picture. */
+static void
+snapshot_find(id view, int depth)
+{
+	Class cls = object_getClass(view);
+	id subviews = class_respondsToSelector(cls, sel_registerName("subviews")) ? SEND(id, view, "subviews") : NULL;
+	long count = subviews ? SEND(long, subviews, "count") : 0;
+
+	if (strcmp(object_getClassName(view), "PBUISnapshotReplicaView") == 0 && class_respondsToSelector(cls, sel_registerName("source"))) {
+		snapshot_wanted(SEND(id, view, "source"));
+	}
+	for (long i = 0; depth < 60 && i < count; i++) {
+		snapshot_find(SEND1(id, subviews, "objectAtIndex:", long, i), depth + 1);
+	}
+}
+
+static void
+snapshot_look(unsigned attempt)
+{
+	dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (attempt == 0 ? 15 : 10) * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+		Class window = objc_getClass("UIWindow");
+		SEL all = sel_registerName("allWindowsIncludingInternalWindows:onlyVisibleWindows:");
+		id windows = window && class_getClassMethod(window, all) ? ((id (*)(Class, SEL, BOOL, BOOL))objc_msgSend)(window, all, 1, 0) : NULL;
+		long count = windows ? SEND(long, windows, "count") : 0;
+
+		for (long i = 0; i < count; i++) {
+			snapshot_find(SEND1(id, windows, "objectAtIndex:", long, i), 0);
+		}
+		if (snapshot_name_now[0] == 0 && attempt < 12) {
+			snapshot_look(attempt + 1);
+		}
+	});
+}
+
+static void
+wallpaper_snapshot(void)
+{
+	char arguments[1024] = "";
+	size_t size = sizeof(arguments) - 1;
+	const char *argument;
+	Method baked, url;
+	int fd;
+
+	if (sysctlbyname("kern.bootargs", arguments, &size, NULL, 0) == 0 &&
+	    (argument = strstr(arguments, "wallpaper_snapshot=0")) != NULL && (argument == arguments || argument[-1] == ' ')) {
+		say("hakios: snapshot: the wallpaper's snapshot is left as Darwin has it (wallpaper_snapshot=0)\n");
+		return;
+	}
+	if ((fd = open(SNAPSHOT_NAME_KEPT, O_RDONLY)) >= 0) {
+		ssize_t got = read(fd, snapshot_name_kept, sizeof(snapshot_name_kept) - 1);
+
+		snapshot_name_kept[got > 0 ? got : 0] = 0;
+		close(fd);
+	}
+	if (snapshot_name_kept[0] != 0) {
+		id image = wallpaper_kept_picture(1080, 2340, 1.0);
+
+		if (image != NULL) {
+			snapshot_picture = (id)CFRetain((CFTypeRef)image);
+		} else {
+			snapshot_name_kept[0] = 0;
+		}
+	}
+	baked = class_getInstanceMethod(objc_getClass("PBUIBakedEffectSnapshotSource"), sel_registerName("snapshot"));
+	url = class_getInstanceMethod(objc_getClass("PBUIURLBackedSnapshotSource"), sel_registerName("snapshot"));
+	if (baked != NULL) {
+		original_baked_snapshot = (id (*)(id, SEL))method_setImplementation(baked, (IMP)baked_snapshot);
+	}
+	if (url != NULL) {
+		original_url_snapshot = (id (*)(id, SEL))method_setImplementation(url, (IMP)url_snapshot);
+	}
+	say("hakios: snapshot: the wallpaper's snapshot sources answer through here (%s, %s); a picture kept from before: %s\n",
+	    baked ? "baked" : "NO baked", url ? "by file" : "NO by file", snapshot_picture ? "yes" : "none");
+	snapshot_look(0);
+}
+
 __attribute__((constructor))
 static void
 hakios_springboard_init(void)
@@ -2376,6 +2586,7 @@
 	wallpaper_cache();
 	status_bar_fallback_is_split();
 	wallpaper_freeze();
+	wallpaper_snapshot();
 	legibility_gradient();
 	original_lock_long_press = (void (*)(id, SEL, id))replace_method("SBLockHardwareButton", "longPress:", 0x1c4f6ab44UL,
