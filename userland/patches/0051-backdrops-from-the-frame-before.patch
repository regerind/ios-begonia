+/*
+ * begonia (y133): backdrops read from the frame before.
+ * A backdrop (Safari's bars, a page's backdrop-filter, Control Centre's materials) reads what the display's picture
+ * holds so far: CoreAnimation draws that picture's texture into a small framebuffer of its own and blurs it there.
+ * Mesa (panfrost) then has to send the picture's work so far to the GPU and, when drawing goes on into it, load it all
+ * again: with YouTube, 12 times a frame, ~10 MB written and read each time, 11-14 thousand ~300 us fragment jobs in 5 s
+ * and every frame at 30 fps (y117-y132). Here the picture's texture, read while another framebuffer is drawn into,
+ * is the copy of the frame before (made at each frame's end, the same way up): nothing to send early, the picture is
+ * drawn in one go, and a backdrop shows what was behind it one frame (16-33 ms) ago.
+ * On by default since y136 (with Mesa 0009: frames under 18 ms with YouTube 0-1% -> 23%, the page seen right); boot-arg glbackdrop=0: off.
+ */
+static int backdrop_prev = 1;
+static GLuint prev_texture, prev_reader, prev_writer;
+static GLsizei prev_width, prev_height;
+static bool prev_valid;
+static unsigned backdrop_swaps, backdrop_said;
+
+/* at a display picture's end: its copy, for the next frame's backdrops */
+static void
+backdrop_keep(struct eagl *e, struct image *image)
+{
+	GLint read = 0, draw = 0, bound = 0;
+
+	(void)e;
+	if (!backdrop_prev || image->width < 1000 || image->height < 2000) {
+		return;
+	}
+	glGetIntegerv(GL_TEXTURE_BINDING_2D, &bound);
+	if (prev_texture == 0 || prev_width != image->width || prev_height != image->height) {
+		if (prev_texture == 0) {
+			glGenTextures(1, &prev_texture);
+		}
+		glBindTexture(GL_TEXTURE_2D, prev_texture);
+		glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, image->width, image->height, 0, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+		glTexParameteri(GL_TEXTURE_2D, 0x2801 /* GL_TEXTURE_MIN_FILTER */, 0x2601 /* GL_LINEAR */);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, 0x2601);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, 0x812f /* GL_CLAMP_TO_EDGE */);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, 0x812f);
+		glBindTexture(GL_TEXTURE_2D, (GLuint)bound);
+		prev_width = image->width;
+		prev_height = image->height;
+		prev_valid = false;
+	}
+	if (prev_reader == 0) {
+		glGenFramebuffers(1, &prev_reader);
+		glGenFramebuffers(1, &prev_writer);
+	}
+	glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read);
+	glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw);
+	glBindFramebuffer(GL_READ_FRAMEBUFFER, prev_reader);
+	glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, image->texture, 0);
+	glBindFramebuffer(GL_DRAW_FRAMEBUFFER, prev_writer);
+	glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, prev_texture, 0);
+	glBlitFramebuffer(0, 0, image->width, image->height, 0, 0, image->width, image->height, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+	glBindFramebuffer(GL_READ_FRAMEBUFFER, (GLuint)read);
+	glBindFramebuffer(GL_DRAW_FRAMEBUFFER, (GLuint)draw);
+	prev_valid = true;
+}
+
+/* before a draw: the display picture's texture, read while drawing elsewhere, swapped for the frame before's */
+static unsigned
+backdrop_swap_begin(struct eagl *e, GLuint was[8])
+{
+	unsigned swapped = 0;
+
+	if (!backdrop_prev || !prev_valid) {
+		return 0;
+	}
+	for (unsigned unit = 0; unit < 8; unit++) {
+		struct image *image;
+		GLuint texture = e->bound[unit];
+
+		was[unit] = 0;
+		if (texture == 0 || texture == e->colour || (image = image_of(e, texture)) == NULL || !image->target ||
+		    !image->drawn || image->texture != texture || image->width != prev_width || image->height != prev_height) {
+			continue;
+		}
+		glActiveTexture(GL_TEXTURE0 + unit);
+		glBindTexture(GL_TEXTURE_2D, prev_texture);
+		was[unit] = texture;
+		swapped |= 1u << unit;
+	}
+	if (swapped) {
+		glActiveTexture(GL_TEXTURE0 + e->unit);
+		backdrop_swaps++;
+		if (backdrop_said++ < 4 || backdrop_swaps % 5000 == 0) {
+			say("hakios-gl: backdrops read from the frame before: %u draws so far\n", backdrop_swaps);
+		}
+	}
+	return swapped;
+}
+
+static void
+backdrop_swap_end(struct eagl *e, unsigned swapped, const GLuint was[8])
+{
+	if (!swapped) {
+		return;
+	}
+	for (unsigned unit = 0; unit < 8; unit++) {
+		if (swapped & (1u << unit)) {
+			glActiveTexture(GL_TEXTURE0 + unit);
+			glBindTexture(GL_TEXTURE_2D, was[unit]);
+		}
+	}
+	glActiveTexture(GL_TEXTURE0 + e->unit);
+}
