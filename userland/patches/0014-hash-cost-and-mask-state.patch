+/*
+ * begonia (x30): has a shown surface changed since its texture was filled? As before -- the seed first, then a
+ * look at the memory -- with the looks counted: a change found while the seed stood still is one the seed missed.
+ */
+static bool
+shown_changed(struct eagl *e, struct image *image)
+{
+	unsigned looked = image->looked;
+	bool changed;
+
+	if (image->target) {
+		return image->wrapped && !image->painted && surface_changed(e, image);
+	}
+	if (IOSurfaceGetSeed(image->surface) != image->seed) {
+		return true;
+	}
+	changed = surface_changed(e, image);
+	if (image->looked != looked) {
+		seed_looks[image->wrapped]++;
+		seed_missed[image->wrapped] += changed;
+	}
+	return changed;
+}
