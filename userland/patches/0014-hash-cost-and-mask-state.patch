+/*
+ * begonia (x30): every 30th frame, at each draw, the text masks (copied 'A008'/'LA08': R8/RG8 with a swizzle,
+ * legacy_format()) on the texture units: a mipmap filter on a texture of one level makes it incomplete, which
+ * samples as opaque black; a swizzle that no longer takes alpha from red (green) makes it opaque. Either is a box.
+ */
+static void
+mask_state(struct eagl *e)
+{
+	GLint active = -1;
+
+	if (e->frames % 30 != 0) {
+		return;
+	}
+	for (unsigned u = 0; u < 8; u++) {
+		struct image *image;
+		GLint min = -1, base = -1, max = -1, alpha = -1, w0 = -1, h0 = -1, w1 = -1, internal = -1, bound = -1;
+		GLint want, level;
+		bool mip, incomplete, lost;
+
+		if (e->bound[u] == 0 || (image = image_of(e, e->bound[u])) == NULL || image->shared || image->target ||
+		    (image->format != 0x1906 && image->format != 0x190a) || image->type != GL_UNSIGNED_BYTE) {
+			continue;
+		}
+		if (active < 0) {
+			glGetIntegerv(0x84e0 /* GL_ACTIVE_TEXTURE */, &active);
+		}
+		glActiveTexture(0x84c0 + u);
+		glGetIntegerv(GL_TEXTURE_BINDING_2D, &bound);
+		glGetTexParameteriv(GL_TEXTURE_2D, 0x2801 /* GL_TEXTURE_MIN_FILTER */, &min);
+		glGetTexParameteriv(GL_TEXTURE_2D, 0x813c /* GL_TEXTURE_BASE_LEVEL */, &base);
+		glGetTexParameteriv(GL_TEXTURE_2D, 0x813d /* GL_TEXTURE_MAX_LEVEL */, &max);
+		glGetTexParameteriv(GL_TEXTURE_2D, 0x8e45 /* GL_TEXTURE_SWIZZLE_A */, &alpha);
+		level = base > 0 ? base : 0;
+		glGetTexLevelParameteriv(GL_TEXTURE_2D, level, 0x1000 /* GL_TEXTURE_WIDTH */, &w0);
+		glGetTexLevelParameteriv(GL_TEXTURE_2D, level, 0x1001 /* GL_TEXTURE_HEIGHT */, &h0);
+		glGetTexLevelParameteriv(GL_TEXTURE_2D, level, 0x1003 /* GL_TEXTURE_INTERNAL_FORMAT */, &internal);
+		glGetTexLevelParameteriv(GL_TEXTURE_2D, level + 1, 0x1000, &w1);
+		mip = min >= 0x2700 && min <= 0x2703;
+		incomplete = w0 == 0 || (mip && max > base && (w0 > 1 || h0 > 1) && w1 <= 0);
+		want = image->format == 0x1906 ? 0x1903 /* GL_RED */ : 0x1904 /* GL_GREEN */;
+		lost = alpha_as_red && alpha != want;
+		mask_checked++;
+		mask_incomplete += incomplete;
+		mask_swizzle += lost;
+		if ((incomplete || lost) ? mask_said++ < 8 : mask_ok_said++ < 3) {
+			say("hakios-gl: mask state, frame %u, unit %u: texture %u (bound %d) of surface %u%s, %d x %d, internal %#x: "
+			    "min filter %#x, levels %d..%d, level 1 width %d, alpha from %#x (wanted %#x)%s%s\n", e->frames, u,
+			    image->texture, bound, IOSurfaceGetID(image->surface), image->wrapped ? " (wrapped)" : "", w0, h0,
+			    internal, min, base, max, w1, alpha, want, incomplete ? "; INCOMPLETE" : "", lost ? "; SWIZZLE LOST" : "");
+		}
+	}
+	if (active >= 0) {
+		glActiveTexture((GLenum)active);
+	}
+}
