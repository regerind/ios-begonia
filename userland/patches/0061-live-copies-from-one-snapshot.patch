 static unsigned live_copies, live_said, live_kept;
 
+/*
+ * begonia (y197): the copies at their own size read one snapshot of the picture a frame, taken where the first of them
+ * is drawn (the picture's batch sent once, the snapshot's too), rather than the picture itself each time (each sent the
+ * picture's batch and loaded it again: YouTube 47-51 -> 41-44 frames a second, y194). What is under a widget is drawn
+ * before the widgets; a later copy misses only what was drawn between the first copy and itself.
+ */
+static GLuint snap_texture, snap_reader, snap_writer;
+static unsigned snap_frame, snaps;
+
+static void
+snapshot_swap_begin(struct eagl *e, struct image *image, GLuint was[8])
+{
+	GLint read = 0, draw = 0, bound = 0;
+
+	for (unsigned unit = 0; unit < 8; unit++) {
+		was[unit] = 0;
+	}
+	if (snap_frame != e->frames + 1) {
+		glGetIntegerv(GL_TEXTURE_BINDING_2D, &bound);
+		if (snap_texture == 0) {
+			glGenTextures(1, &snap_texture);
+			glBindTexture(GL_TEXTURE_2D, snap_texture);
+			glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, image->width, image->height, 0, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+			glTexParameteri(GL_TEXTURE_2D, 0x2801 /* GL_TEXTURE_MIN_FILTER */, 0x2601 /* GL_LINEAR */);
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, 0x2601);
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, 0x812f /* GL_CLAMP_TO_EDGE */);
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, 0x812f);
+			glBindTexture(GL_TEXTURE_2D, (GLuint)bound);
+			glGenFramebuffers(1, &snap_reader);
+			glGenFramebuffers(1, &snap_writer);
+		}
+		glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read);
+		glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw);
+		glBindFramebuffer(GL_READ_FRAMEBUFFER, snap_reader);
+		glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, image->texture, 0);
+		glBindFramebuffer(GL_DRAW_FRAMEBUFFER, snap_writer);
+		glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, snap_texture, 0);
+		glBlitFramebuffer(0, 0, image->width, image->height, 0, 0, image->width, image->height, GL_COLOR_BUFFER_BIT,
+		    GL_NEAREST);
+		glBindFramebuffer(GL_READ_FRAMEBUFFER, (GLuint)read);
+		glBindFramebuffer(GL_DRAW_FRAMEBUFFER, (GLuint)draw);
+		glFlush();              /* (the reader sent: drawing on into the picture finds none waiting, see 0057) */
+		snap_frame = e->frames + 1;
+		snaps++;
+	}
+	glActiveTexture(GL_TEXTURE0);
+	glBindTexture(GL_TEXTURE_2D, snap_texture);
+	was[0] = image->texture;
+	glActiveTexture(GL_TEXTURE0 + e->unit);
+}
