  * legacy_format()) on the texture units: a mipmap filter on a texture of one level makes it incomplete, which
  * samples as opaque black; a swizzle that no longer takes alpha from red (green) makes it opaque. Either is a box.
  */
+/*
+ * begonia (x49): the black columns of the emoji keyboard (x48's picture: whole columns opaque black after a fast
+ * scroll) are not text masks. Every texture bound to a unit, every 30th frame at each draw: one that samples as
+ * incomplete -- a mipmap filter and a level missing, or no storage at its base level -- comes out opaque black.
+ */
+static void
+any_state(struct eagl *e)
+{
+	GLint active = -1;
+
+	if (e->frames % 30 != 0) {
+		return;
+	}
+	for (unsigned u = 0; u < 8; u++) {
+		struct image *image;
+		GLint min = -1, base = -1, max = -1, w0 = -1, h0 = -1, w1 = -1, internal = -1, level;
+		bool mip, incomplete;
+
+		if (e->bound[u] == 0) {
+			continue;
+		}
+		if (active < 0) {
+			glGetIntegerv(0x84e0 /* GL_ACTIVE_TEXTURE */, &active);
+		}
+		glActiveTexture(0x84c0 + u);
+		glGetTexParameteriv(GL_TEXTURE_2D, 0x2801 /* GL_TEXTURE_MIN_FILTER */, &min);
+		glGetTexParameteriv(GL_TEXTURE_2D, 0x813c /* GL_TEXTURE_BASE_LEVEL */, &base);
+		glGetTexParameteriv(GL_TEXTURE_2D, 0x813d /* GL_TEXTURE_MAX_LEVEL */, &max);
+		level = base > 0 ? base : 0;
+		glGetTexLevelParameteriv(GL_TEXTURE_2D, level, 0x1000 /* GL_TEXTURE_WIDTH */, &w0);
+		glGetTexLevelParameteriv(GL_TEXTURE_2D, level, 0x1001 /* GL_TEXTURE_HEIGHT */, &h0);
+		glGetTexLevelParameteriv(GL_TEXTURE_2D, level, 0x1003 /* GL_TEXTURE_INTERNAL_FORMAT */, &internal);
+		glGetTexLevelParameteriv(GL_TEXTURE_2D, level + 1, 0x1000, &w1);
+		mip = min >= 0x2700 && min <= 0x2703;
+		incomplete = w0 <= 0 || (mip && max > base && (w0 > 1 || h0 > 1) && w1 <= 0);
+		any_checked++;
+		any_incomplete += incomplete;
+		if (incomplete && any_said++ < 12) {
+			image = image_of(e, e->bound[u]);
+			say("hakios-gl: texture state, frame %u, unit %u: texture %u%s, %d x %d, internal %#x, min filter %#x, levels "
+			    "%d..%d, level 1 width %d: INCOMPLETE\n", e->frames, u, e->bound[u], image == NULL ? " (CoreAnimation's own)" :
+			    image->shared ? " (an IOSurface, shared)" : image->wrapped ? " (an IOSurface, wrapped, copied)" :
+			    " (an IOSurface, copied)", w0, h0, internal, min, base, max, w1);
+		}
+	}
+	if (active >= 0) {
+		glActiveTexture((GLenum)active);
+	}
+}
