+/*
+ * begonia: the input path's state, every 10 s for the first two minutes. The console ring keeps only
+ * the last part of a run, and the lines the services print when they are made are gone by the time
+ * the log is read; this says again whether the event server opened (and closed) the touch screen
+ * and the buttons, and where the driver's samples went: read, sent as touches, turned into a lock
+ * press to wake the display, or swallowed after one.
+ */
+static void
+say_service(char *line, size_t size, const char *what, struct service *s)
+{
+	if (s == NULL) {
+		snprintf(line, size, "%s none", what);
+		return;
+	}
+	snprintf(line, size, "%s opened %d attempts %u opens %u closes %u sets %u asks %u", what, s->opened, s->attempts,
+	    s->opens, s->closes, s->sets, s->copies);
+}
+
+static void *
+input_status_thread(__unused void *arg)
+{
+	char screen_line[160], buttons_line[160];
+
+	pthread_setname_np("begonia input status");
+	for (int i = 1; i <= 12; i++) {
+		sleep(10);
+		say_service(screen_line, sizeof(screen_line), "screen", status_screen);
+		say_service(buttons_line, sizeof(buttons_line), "buttons", status_buttons);
+		say("hakios: input status %ds: %s | %s | read %u touches %u sent %u woke %u swallowed %u buttons %u mode %#x\n",
+		    i * 10, screen_line, buttons_line, status_read, status_touches, status_sent, status_woke, status_swallowed,
+		    status_buttons_sent, touch_mode);
+	}
+	return NULL;
+}
