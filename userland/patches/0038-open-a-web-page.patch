+/*
+ * begonia: com.hakios.open.url opens https://example.com (Safari, by LSApplicationWorkspace) for sessions nobody is at:
+ * a real page over the Wi-Fi the phone joined, to see whether WebKit draws it.
+ */
+static void
+open_url(const char *text)
+{
+	id workspace = SEND(id, objc_getClass("LSApplicationWorkspace"), "defaultWorkspace");
+	id string = SEND1(id, objc_getClass("NSString"), "stringWithUTF8String:", const char *, text);
+	id url = SEND1(id, objc_getClass("NSURL"), "URLWithString:", id, string);
+	SEL open = sel_registerName("openURL:");
+
+	if (workspace == NULL || url == NULL || !class_respondsToSelector(object_getClass(workspace), open)) {
+		say("hakios: open: %s: no LSApplicationWorkspace openURL: here\n", text);
+		return;
+	}
+	say("hakios: open: %s: %d\n", text, ((BOOL (*)(id, SEL, id))objc_msgSend)(workspace, open, url));
+}
