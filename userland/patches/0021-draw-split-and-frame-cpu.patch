@@ -150,6 +150,25 @@
  * eagl_enter() to eagl_leave()) and so how much is between them: CoreAnimation's own work.
  */
 static uint64_t inside_began, inside_us;
+/*
+ * begonia (x45): of the time in glDrawElements' entry, how much is the library's own call (Mesa: the rest is this
+ * bridge around it), and by which way the draws go; and of a frame's time, how much the thread was on a processor.
+ */
+static uint64_t draw_lib_us, frame_cpu_began, frame_cpu_us;
+static unsigned draw_group, draw_plain, draw_other;
+
+static uint64_t
+thread_cpu_us(void)
+{
+	thread_basic_info_data_t basic;
+	mach_msg_type_number_t count = THREAD_BASIC_INFO_COUNT;
+
+	if (thread_info(pthread_mach_thread_np(pthread_self()), THREAD_BASIC_INFO, (thread_info_t)&basic, &count) != KERN_SUCCESS) {
+		return 0;
+	}
+	return (uint64_t)basic.user_time.seconds * 1000000 + (uint64_t)basic.user_time.microseconds +
+	    (uint64_t)basic.system_time.seconds * 1000000 + (uint64_t)basic.system_time.microseconds;
+}
 static uint64_t now_us(void);
 static void eagl_trace(const char *format, ...) __attribute__((format(printf, 1, 2)));
 static void eagl_trace_floats(const float *values, int count);
