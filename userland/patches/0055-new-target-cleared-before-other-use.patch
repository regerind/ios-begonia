 /* ---- the entries written by hand ---------------------------------------------------------------- */
 
+/*
+ * begonia (y158): a new target whose clear is put off till it is first drawn into (0054) can be used before that in
+ * other ways -- bound to be read, copied into, uploaded into. y156/y157: with 0054 the Control Center's volume slider
+ * was gone and came back with glclearlate=0. Used so, the target is cleared first, the old way; how often, by which
+ * way, is counted and said.
+ */
+static unsigned due_bound, due_copied, due_uploaded;
+
+static void
+clear_due_now(struct eagl *e, GLuint texture, unsigned *why)
+{
+	struct image *image;
+	GLint draw = 0;
+
+	if (texture == 0 || e->image_count == 0 || (image = image_of(e, texture)) == NULL || !image->clear_due) {
+		return;
+	}
+	image->clear_due = false;
+	(*why)++;
+	glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw);
+	if (e->writer == 0) {
+		glGenFramebuffers(1, &e->writer);
+	}
+	glBindFramebuffer(GL_DRAW_FRAMEBUFFER, e->writer);
+	glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, image->texture, 0);
+	clear_bound();
+	glBindFramebuffer(GL_DRAW_FRAMEBUFFER, (GLuint)draw);
+	if (*why < 4 || *why % 200 == 0) {
+		say("hakios-gl: target %u used before it was drawn into: cleared first (bound %u, copied into %u, uploaded into %u)\n",
+		    image->texture, due_bound, due_copied, due_uploaded);
+	}
+}
