+/*
+ * begonia: Freeform's drawing tools other than the pen. Every one of them is a "brush stroke", which Freeform draws
+ * with Metal ("All brush strokes should draw with Metal!", "Can't initialize metal buffers without a device!" in its
+ * binary), and an application has no Metal device here: the strokes drew nothing and, pushed further, the
+ * application went down. Freeform also knows how to draw a brush stroke without Metal (it asks itself isMetalCapable,
+ * p_isMetalCapable and brushStrokeUsesMetal, and has p_shouldDrawAsVectorInContext: for the rest), so in Freeform
+ * those questions are answered no. This library is inserted into Freeform for it (etc/inject.conf,
+ * tools/make_gles_support.py). Boot-arg freeform_metal=1: left as it was.
+ */
+static BOOL
+freeform_no(__unused id self, __unused SEL selector)
+{
+	return NO;
+}
+
+static void
+freeform_without_metal(void)
+{
+	static const char *const questions[] = { "isMetalCapable", "p_isMetalCapable", "brushStrokeUsesMetal" };
+	char arguments[1024] = "";
+	size_t size = sizeof(arguments) - 1;
+	unsigned count = 0, replaced = 0;
+	Class *classes;
+
+	if (sysctlbyname("kern.bootargs", arguments, &size, NULL, 0) == 0 && strstr(arguments, "freeform_metal=1") != NULL) {
+		say("hakios: Freeform: its brushes are left to Metal (freeform_metal=1)\n");
+		return;
+	}
+	classes = objc_copyClassList(&count);
+	for (unsigned i = 0; classes != NULL && i < count; i++) {
+		const char *name = class_getName(classes[i]);
+
+		if (strncmp(name, "CRL", 3) != 0 && strstr(name, "Freeform") == NULL) {
+			continue;
+		}
+		for (int meta = 0; meta < 2; meta++) {
+			Class cls = meta ? object_getClass((id)classes[i]) : classes[i];
+			unsigned methods = 0;
+			Method *list = class_copyMethodList(cls, &methods);
+
+			for (unsigned m = 0; list != NULL && m < methods; m++) {
+				const char *selector = sel_getName(method_getName(list[m])), *types = method_getTypeEncoding(list[m]);
+
+				for (size_t q = 0; q < sizeof(questions) / sizeof(questions[0]); q++) {
+					if (strcmp(selector, questions[q]) == 0 && types != NULL && (types[0] == 'B' || types[0] == 'c')) {
+						method_setImplementation(list[m], (IMP)freeform_no);
+						replaced++;
+						say("hakios: Freeform: %c[%s %s] answers no\n", meta ? '+' : '-', name, selector);
+					}
+				}
+			}
+			free(list);
+		}
+	}
+	free(classes);
+	say("hakios: Freeform[%d]: %u of its questions about Metal answer no, of %u classes looked at\n", getpid(), replaced, count);
+}
+
