+/* begonia: a picture's colours, sixteen samples of it drawn small: is the wallpaper's snapshot a picture or one flat colour? */
+static void
+pbui_image_colour(const char *what, id image)
+{
+	CGImageRef cg = image != NULL && class_respondsToSelector(object_getClass(image), sel_registerName("CGImage")) ?
+	    SEND(CGImageRef, image, "CGImage") : NULL;
+	uint8_t px[4 * 4 * 4];
+	CGColorSpaceRef space;
+	CGContextRef context;
+
+	if (cg == NULL) {
+		say("hakios: pbui: %s: no picture to look at (%s)\n", what, image ? object_getClassName(image) : "none");
+		return;
+	}
+	memset(px, 0, sizeof(px));
+	space = CGColorSpaceCreateDeviceRGB();
+	context = CGBitmapContextCreate(px, 4, 4, 8, 16, space, kCGImageAlphaPremultipliedLast);
+	if (context != NULL) {
+		CGContextDrawImage(context, CGRectMake(0, 0, 4, 4), cg);
+		CGContextRelease(context);
+	}
+	CGColorSpaceRelease(space);
+	say("hakios: pbui: %s: picture %zu x %zu, %zu bits a pixel; red,green,blue of four of sixteen parts: %u,%u,%u %u,%u,%u "
+	    "%u,%u,%u %u,%u,%u\n", what, CGImageGetWidth(cg), CGImageGetHeight(cg), CGImageGetBitsPerPixel(cg), px[0], px[1], px[2],
+	    px[20], px[21], px[22], px[40], px[41], px[42], px[60], px[61], px[62]);
+}
