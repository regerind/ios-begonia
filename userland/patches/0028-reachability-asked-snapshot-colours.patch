+/*
+ * begonia: the notification com.hakios.reach asks SpringBoard for one-handed mode (reachability) as the swipe down
+ * on the bottom edge does, for sessions nobody is at: a scripted swipe did not bring it.
+ */
+static void
+reach(void)
+{
+	Class cls = objc_getClass("SBReachabilityManager");
+	id manager = cls != NULL && class_getClassMethod(cls, sel_registerName("sharedInstance")) ? SEND(id, cls, "sharedInstance") : NULL;
+	Class kind = manager ? object_getClass(manager) : NULL;
+
+	say("hakios: reach: manager %s; enabled %d; active %d\n", manager ? "there" : "not there",
+	    kind && class_respondsToSelector(kind, sel_registerName("reachabilityEnabled")) ? SEND(BOOL, manager, "reachabilityEnabled") : -1,
+	    kind && class_respondsToSelector(kind, sel_registerName("reachabilityModeActive")) ? SEND(BOOL, manager, "reachabilityModeActive") : -1);
+	if (kind != NULL && class_respondsToSelector(kind, sel_registerName("toggleReachability"))) {
+		SEND(void, manager, "toggleReachability");
+		say("hakios: reach: asked; active %d\n",
+		    class_respondsToSelector(kind, sel_registerName("reachabilityModeActive")) ? SEND(BOOL, manager, "reachabilityModeActive") : -1);
+	}
+}
