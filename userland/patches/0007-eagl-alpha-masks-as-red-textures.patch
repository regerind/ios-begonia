+/*
+ * begonia: text that applications draw comes as masks of opacity alone -- GL_ALPHA textures, 834 of them in a five
+ * minute run -- and on the Mali-G76 every label, every key of the keyboard that is drawn that way, came out as its
+ * whole rectangle filled in: opacity 1 wherever the mask was read. Mesa's panfrost gives GL_ALPHA and
+ * GL_LUMINANCE_ALPHA hardware formats of their own on this generation (pan_format.c, "Obsolete formats removed in
+ * Valhall": A8_UNORM, R8A8_UNORM); the red and red-green formats are what everything else uses. So such a texture is
+ * made a GL_R8 or GL_RG8 one, with its channels sent where the old format had them (OpenGL ES 3's texture swizzle):
+ * opacity from red, or luminance from red and opacity from green. Only textures that are given pixels: one made empty
+ * may be drawn into, and what is drawn into it is opacity, not red. Boot-arg glalpha=0: as CoreAnimation asks.
+ */
+static int alpha_as_red = 1;
+
+static bool
+legacy_format(GLenum target, GLenum *internal, GLenum *format, GLenum type, bool swizzle)
+{
+	GLint to[4];
+
+	if (!alpha_as_red || type != GL_UNSIGNED_BYTE) {
+		return false;
+	}
+	if (*format == 0x1906) {                        /* GL_ALPHA */
+		*internal = 0x8229;                     /* GL_R8 */
+		*format = 0x1903;                       /* GL_RED */
+		to[0] = to[1] = to[2] = 0 /* GL_ZERO */, to[3] = 0x1903;
+	} else if (*format == 0x190a) {                 /* GL_LUMINANCE_ALPHA */
+		*internal = 0x822b;                     /* GL_RG8 */
+		*format = 0x8227;                       /* GL_RG */
+		to[0] = to[1] = to[2] = 0x1903, to[3] = 0x1904 /* GL_GREEN */;
+	} else {
+		return false;
+	}
+	if (swizzle) {
+		glTexParameteri(target, 0x8e42 /* GL_TEXTURE_SWIZZLE_R */, to[0]);
+		glTexParameteri(target, 0x8e43, to[1]);
+		glTexParameteri(target, 0x8e44, to[2]);
+		glTexParameteri(target, 0x8e45, to[3]);
+	}
+	return true;
+}
