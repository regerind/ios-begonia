 /*
+ * begonia: no OpenGL ES context in SpringBoard. SpringBoard draws nothing with GL (backboardd composites), and it has
+ * no Metal device, so CoreImage (CoreUI's text effects, with Bold Text on) took its OpenGL ES path, made an
+ * EAGLContext of Apple's OpenGLES with no driver behind it and jumped through its empty function table
+ * (CoreImage+0x19c58c: entry(rend, GL_DEPTH_TEST), pc 0: SpringBoard died at every start with Bold Text on).
+ * initWithAPI: and initWithAPI:sharegroup: answer nil here, as on a device without OpenGL ES, and CoreImage draws
+ * on the CPU instead.
+ */
+static id
+no_gles_init(__unused id self, __unused SEL command, __unused unsigned long api)
+{
+	static int said;
+
+	if (!said++) {
+		say("hakios: SpringBoard: an OpenGL ES context was asked for (api %lu): none here (CoreImage draws on the CPU)\n", api);
+	}
+	return nil;
+}
+
+static id
+no_gles_init_shared(id self, SEL command, unsigned long api, __unused id sharegroup)
+{
+	return no_gles_init(self, command, api);
+}
+
+static void
+no_gles_in_springboard(void)
+{
+	Class context;
+
+	dlopen("/System/Library/Frameworks/OpenGLES.framework/OpenGLES", RTLD_NOW);
+	if ((context = objc_getClass("EAGLContext")) == NULL) {
+		say("hakios: SpringBoard: no EAGLContext class to take OpenGL ES away from\n");
+		return;
+	}
+	class_replaceMethod(context, sel_registerName("initWithAPI:"), (IMP)no_gles_init, "@24@0:8Q16");
+	class_replaceMethod(context, sel_registerName("initWithAPI:sharegroup:"), (IMP)no_gles_init_shared, "@32@0:8Q16@24");
+	say("hakios: SpringBoard: EAGLContext answers nil (CoreImage on the CPU)\n");
+}
+
+/*
  * Open the tweak loader of the package manager's prefix, when there is one. Nothing here depends on
  * it: without a prefix (or without ElleKit in it) the file is not there and this does nothing.
  */
@@ -2606,6 +2647,7 @@
 	caenv();
 	main_thread_cpu();
 	display_link_rates();
