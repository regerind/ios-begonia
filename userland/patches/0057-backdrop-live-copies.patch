+/*
+ * begonia (y191): a copy of part of the display's picture at its own size (one pixel of it to one pixel drawn) is not a
+ * backdrop to be blurred but what is under something, to be put back: the Today view's widgets have CoreAnimation
+ * copy the picture under each corner, fill the square, then draw the corners from that copy. Read from the frame
+ * before (0051), what is under a corner is last frame's widget, square corners and all: coloured marks that fed on
+ * themselves (y177-y190; gone with glbackdrop=0 and PAN_RENAME=0). Such a copy reads this frame's picture; then the
+ * batch that read it is sent at once (glFlush), so that drawing on into the picture finds no reader waiting and Mesa
+ * 0009 does not give it new memory (that lost the frame drawn so far: the black screen of y187/y188).
+ * Boot-arg gllivecopy=0: every read swapped, as before.
+ */
+static int live_copy_on = 1;
+static unsigned live_copies, live_said;
+
+static bool
+float_bounds(const struct eagl *e, unsigned a, GLenum type, const void *indices, GLint first, GLsizei count, float low[2],
+    float high[2])
+{
+	const uint8_t *base = e->arrays[a].pointer;
+	GLint size = e->arrays[a].size;
+
+	if (base == NULL || e->arrays[a].type != GL_FLOAT || size < 2 || size > 4 || count <= 0 || count > 4096) {
+		return false;
+	}
+	size_t stride = e->arrays[a].stride ? (size_t)e->arrays[a].stride : (size_t)size * 4;
+	low[0] = low[1] = 1e9f;
+	high[0] = high[1] = -1e9f;
+	for (GLsizei i = 0; i < count; i++) {
+		unsigned vertex = indices == NULL ? (unsigned)(first + i) : type == GL_UNSIGNED_SHORT ?
+		    ((const uint16_t *)indices)[i] : type == GL_UNSIGNED_BYTE ? ((const uint8_t *)indices)[i] :
+		    ((const uint32_t *)indices)[i];
+		float p[4] = { 0, 0, 0, 1 };
+		memcpy(p, base + (size_t)vertex * stride, (size_t)size * 4);
+		for (unsigned k = 0; k < 2; k++) {
+			low[k] = p[k] < low[k] ? p[k] : low[k];
+			high[k] = p[k] > high[k] ? p[k] : high[k];
+		}
+	}
+	return true;
+}
+
+/* true: this draw reads the display's picture (unit 0) one pixel to one pixel while drawing elsewhere */
+static bool
+backdrop_live_copy(struct eagl *e, GLenum type, const void *indices, GLint first, GLsizei count)
+{
+	struct image *image;
+	float pl[2], ph[2], tl[2], th[2];
+	GLint array_buffer = 0, element_buffer = 0;
+	GLuint texture = e->bound[0];
+
+	if (!live_copy_on || !backdrop_prev || !prev_valid || texture == 0 || texture == e->colour ||
+	    (image = image_of(e, texture)) == NULL || !image->target || !image->drawn || image->texture != texture ||
+	    image->width != prev_width || image->height != prev_height) {
+		return false;
+	}
+	glGetIntegerv(0x8894 /* GL_ARRAY_BUFFER_BINDING */, &array_buffer);
+	if (array_buffer != 0) {
+		return false;
+	}
+	if (indices != NULL) {
+		glGetIntegerv(0x8895 /* GL_ELEMENT_ARRAY_BUFFER_BINDING */, &element_buffer);
+		if (element_buffer != 0) {
+			return false;
+		}
+	}
+	if (!float_bounds(e, 0, type, indices, first, count, pl, ph) || !float_bounds(e, 2, type, indices, first, count, tl, th)) {
+		return false;
+	}
+	float dw = ph[0] - pl[0], dh = ph[1] - pl[1];
+	float sw = (th[0] - tl[0]) * (float)image->width, sh = (th[1] - tl[1]) * (float)image->height;
+	if (dw < 2.0f || dh < 2.0f || dw > 8192.0f || dh > 8192.0f || sw < 0.0f || sh < 0.0f) {
+		return false;           /* not pixels (or texture places turned round): left to the swap */
+	}
+	float rx = sw / dw, ry = sh / dh;
+	if (rx < 0.8f || rx > 1.25f || ry < 0.8f || ry > 1.25f) {
+		return false;           /* made smaller (or bigger): a backdrop's blur */
+	}
+	live_copies++;
+	if (live_said++ < 4 || live_copies % 2000 == 0) {
+		say("hakios-gl: a copy of the picture at its own size (%.0f x %.0f): read from this frame, %u so far\n", dw, dh,
+		    live_copies);
+	}
+	return true;
+}
