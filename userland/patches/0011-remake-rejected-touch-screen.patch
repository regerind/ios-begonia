+/*
+ * begonia, from the ios-s9plus-exynos reference (keep_screen()): the other way the event server's start
+ * goes wrong. backboardd sees the touch screen but reads its usage page as 0 ("*** unexpected digitizer
+ * usage pair") and keeps waiting for a main screen digitizer, so no touch ever arrives -- while the lock
+ * button, a service of its own kind, works. It sets "TouchDetectionMode" on the service either way, and
+ * "QuantizationDPI" just before that only when it takes it. A touch screen turned down is made again, and
+ * backboardd reads it afresh. (x19-x21, x24: no touch; x15, x22: touch -- whichever way the start went.)
+ */
+static IOHIDServiceClientRef
+keep_screen(IOHIDEventSystemClientRef client, IOHIDServiceClientRef screen)
+{
+	for (int attempt = 1; attempt <= 3 && screen != NULL && status_screen != NULL; attempt++) {
+		struct service *made = status_screen;
+		int tenths = 0;
+
+		while (!made->judged && !made->taken && tenths++ < 600) {
+			usleep(100000);
+		}
+		for (tenths = 0; made->judged && !made->taken && tenths < 20; tenths++) {
+			usleep(100000);
+		}
+		if (made->taken || !made->judged) {
+			say("hakios: input: backboardd %s the touch screen\n", made->taken ? "took" : "has not decided about");
+			return screen;
+		}
+		say("hakios: input: backboardd turned the touch screen down (remake %d): making it again\n", attempt);
+		remakes++;
+		IOHIDVirtualServiceClientRemove(screen);
+		CFRelease(screen);
+		screen = make_service(client, "HakiOS touch screen", HID_PAGE_DIGITIZER, HID_USAGE_TOUCH_SCREEN, true);
+	}
+	return screen;
+}
