 		}
+		{
+			unsigned why = !share_surfaces ? 0 : image->invert ? 1 : image->alpha_first ? 2 :
+			    image->format != GL_BGRA || image->type != GL_UNSIGNED_BYTE ? 3 : image->plane != 0 ? 4 :
+			    (size_t)image->width != IOSurfaceGetWidth(surface) || (size_t)image->height != IOSurfaceGetHeight(surface) ? 5 : 6;
+			size_t bytes = IOSurfaceGetBytesPerRow(surface) * IOSurfaceGetHeight(surface);
+
+			refuse_count[why]++;
+			refuse_bytes[why] += bytes;
+			/* the big ones, whenever: a full-screen copy is what costs a frame */
+			if (bytes >= (4u << 20) && (refuse_count[why] < 8 || refuse_count[why] % 500 == 0)) {
+				say("hakios-gl: big surface %u ('%.4s' %zu x %zu, %zu bytes a row, texture %u x %u, format %#x/%#x) copied: %s
+",
+				    IOSurfaceGetID(surface), (const char *)&(uint32_t){ OSSwapInt32(IOSurfaceGetPixelFormat(surface)) },
+				    IOSurfaceGetWidth(surface), IOSurfaceGetHeight(surface), IOSurfaceGetBytesPerRow(surface),
+				    (unsigned)image->width, (unsigned)image->height, image->format, image->type, refuse_name[why]);
+			}
+		}
 		e->refused++;
 		return false;
 	}
