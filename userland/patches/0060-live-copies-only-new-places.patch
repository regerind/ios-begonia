 static int live_copy_on = 1;
-static unsigned live_copies, live_said;
+static unsigned live_copies, live_said, live_kept;
 
 static bool
 float_bounds(const struct eagl *e, unsigned a, GLenum type, const void *indices, GLint first, GLsizei count, float low[2],
@@ -4499,7 +4499,7 @@
 			scale[1] = m[1] < 0 ? -m[1] : m[1];
 		}
 	}
-	float dw = 0, dh = 0;
+	float dw = 0, dh = 0, read_low[2] = { 1e9f, 1e9f }, read_high[2] = { -1e9f, -1e9f };
 	for (GLsizei tri = 0; tri < count; tri += 3) {
 		const uint8_t *one = indices;
 		GLsizei at = indices == NULL ? first + tri : tri;
@@ -4526,11 +4526,47 @@
 		}
 		dw = tw > dw ? tw : dw;
 		dh = tht > dh ? tht : dh;
+		for (unsigned k = 0; k < 2; k++) {
+			float lo = tl[k] * scale[k] * (float)(k ? image->height : image->width);
+			float hi = th[k] * scale[k] * (float)(k ? image->height : image->width);
+			read_low[k] = lo < read_low[k] ? lo : read_low[k];
+			read_high[k] = hi > read_high[k] ? hi : read_high[k];
+		}
+	}
+	/*
+	 * (y195) Only where such a copy is new. Read from this frame once, what it puts back is right; the next frame's
+	 * copy of the same place, read from the frame before, then finds what is right there too (what is under a corner
+	 * is put back from what was put back). YouTube makes ~5 such copies a frame (50 x 50), and reading each from this
+	 * frame sent the picture's batch and loaded it again: 47-51 -> 41-44 frames a second (y194). A copy of a place that
+	 * was copied in the frame before is left to the swap.
+	 */
+	{
+		static struct { int place[4]; unsigned frame; } seen[64];     /* frame: the frame copied in, plus one */
+		static unsigned next;
+		int place[4] = { (int)read_low[0], (int)read_low[1], (int)read_high[0], (int)read_high[1] };
+		unsigned now = e->frames + 1;
+
+		for (unsigned s = 0; s < 64; s++) {
+			if (seen[s].frame != 0 && memcmp(seen[s].place, place, sizeof(place)) == 0) {
+				unsigned before = seen[s].frame;
+
+				seen[s].frame = now;
+				if (before == now || before + 1 == now) {
+					live_kept++;
+					return false;
+				}
+				goto live;
+			}
+		}
+		memcpy(seen[next].place, place, sizeof(place));
+		seen[next].frame = now;
+		next = (next + 1) % 64;
 	}
+live:
 	live_copies++;
 	if (live_said++ < 4 || live_copies % 2000 == 0) {
-		say("hakios-gl: a copy of the picture at its own size (%.0f x %.0f): read from this frame, %u so far\n", dw, dh,
-		    live_copies);
+		say("hakios-gl: a copy of the picture at its own size (%.0f x %.0f): read from this frame, %u so far (%u of places "
+		    "copied the frame before left to the swap)\n", dw, dh, live_copies, live_kept);
 	}
 	return true;
 }
