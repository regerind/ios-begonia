+int
+hakios_gl_surface_plane_texture(struct hakios_gl *gl, uint32_t surface, uint32_t plane)
+{
+	if (surface > 0x3fffffffu || plane > 1) {
+		return 0;
+	}
+	return hakios_gl_surface_texture(gl, surface | 0x80000000u | plane << 30);
+}
